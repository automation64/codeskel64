$ORIGIN X_DOMAIN_NAME_X.
$TTL X_DEFAULT_TTL_X

@   IN  SOA X_PRIMARY_NS_X. X_ADMIN_EMAIL_X. (
            X_SERIAL_X     ; Serial (YYYYMMDDNN)
            X_REFRESH_X    ; Refresh (e.g. 3600)
            X_RETRY_X      ; Retry (e.g. 900)
            X_EXPIRE_X     ; Expire (e.g. 1209600)
            X_MINIMUM_X    ) ; Negative Cache TTL (e.g. 300)

; ============================================================================
; Name Servers
; ============================================================================

@               IN  NS      X_PRIMARY_NS_X.
@               IN  NS      X_SECONDARY_NS_X.

; ============================================================================
; Mail
; ============================================================================

@               IN  MX 10   mail

; ============================================================================
; Host Records
; ============================================================================

@               IN  A       X_IPV4_ADDRESS_X
; @             IN  AAAA    X_IPV6_ADDRESS_X

www             IN  CNAME   @
mail            IN  A       X_MAIL_IPV4_X
; mail          IN  AAAA    X_MAIL_IPV6_X

ns1             IN  A       X_NS1_IPV4_X
; ns1           IN  AAAA    X_NS1_IPV6_X

ns2             IN  A       X_NS2_IPV4_X
; ns2           IN  AAAA    X_NS2_IPV6_X

ftp             IN  CNAME   @
autodiscover    IN  CNAME   mail

; ============================================================================
; Service Records
; ============================================================================

; _sip._tcp     IN  SRV 10 60 5060 sip
; _ldap._tcp    IN  SRV 10 100 389 dc1

; ============================================================================
; TXT Records
; ============================================================================

@               IN  TXT     "v=spf1 mx a -all"

; DKIM example
; selector1._domainkey IN TXT (
;   "v=DKIM1; k=rsa; p=X_PUBLIC_KEY_X"
; )

; DMARC example
; _dmarc        IN  TXT "v=DMARC1; p=quarantine"

; Domain verification examples
; @             IN  TXT "google-site-verification=XXXXXXXX"
; @             IN  TXT "MS=XXXXXXXX"

; ============================================================================
; CAA (optional)
; ============================================================================

; @             IN  CAA 0 issue "letsencrypt.org"
; @             IN  CAA 0 iodef "mailto:hostmaster@X_DOMAIN_NAME_X"

; ============================================================================
; Aliases
; ============================================================================

; api           IN  CNAME   @
; blog          IN  CNAME   @
; vpn           IN  A       X_VPN_IPV4_X
